# ─────────────────────────────────────────────────────────────────────────────
#  ASTRA backend configuration — copy to backend/.env
#  Every key is OPTIONAL. With none set, ASTRA runs on free keyless data
#  (Yahoo Finance, NSE, Binance public data) and SQLite.
#  Keys can also be entered in the UI: Settings → Market Data API Keys.
#  ASTRA is PAPER TRADING ONLY — no real orders are ever placed.
# ─────────────────────────────────────────────────────────────────────────────

# Database (blank = SQLite at backend/astra_trading.db)
DATABASE_URL=

# Redis for Celery workers (optional — without it the API runs the position
# monitor in-process)
REDIS_URL=redis://localhost:6379/0

# Auth: "jwt" (login required) or "bypass" (local dev only; needs PAPER_TRADING=true)
AUTH_MODE=jwt
PAPER_TRADING=true
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── Optional market-data keys ────────────────────────────────────────────────
# Twelve Data — free plan: US stocks + crypto (NSE needs a paid plan)
TWELVE_DATA_KEY=
# Alpha Vantage — free plan: 25 requests/day, daily bars only
ALPHA_VANTAGE_API_KEY=
# Dhan HQ — market DATA only (requires Dhan Data API plan; tokens expire)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Upstox v2 — market DATA (2y daily / 1mo 15m). Token refreshed via /upstox/login
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/upstox/callback
UPSTOX_ACCESS_TOKEN=

# ── Optional LLM keys (agent pipeline) ───────────────────────────────────────
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ── Tuning ───────────────────────────────────────────────────────────────────
# ASTRA_HTTP_TIMEOUT=8            # seconds per provider request
# ASTRA_ENABLE_NSE=true           # NSE website scraping fallback
# ASTRA_ALLOW_SYNTHETIC=false     # synthetic intraday bars for backtests (dev only)
# ASTRA_INPROCESS_MONITOR=        # force in-process SL/TP monitor on/off
# POSITION_MONITOR_INTERVAL=15
# SIGNAL_TTL_HOURS=24
# MAX_POSITIONS=5
# MAX_DAILY_LOSS=10000
