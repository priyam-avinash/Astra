# ASTRA Stack Environment — copy to .env and edit for your deployment
# (kept in repo so contributors know what to set; real .env is gitignored)

# ── Database & cache ─────────────────────────────────────────────────────
POSTGRES_USER=astra
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
POSTGRES_DB=astra_trading

# ── Backend ──────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_with_python_secrets_token_urlsafe_48
PAPER_TRADING=true
AUTH_MODE=jwt

# Comma-separated list of origins allowed to hit the API (CORS allowlist).
# Set to your real frontend URL(s) in production.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Frontend (Vite reads these at build time, not runtime) ──────────────
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
