{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "cd frontend && VITE_DISABLE_WS=1 npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{frontend/**,docs/**,backend/tests/**,backend/backtest_results/**,backend/app/models/saved_models/*.keras,backend/.venv/**,**/__pycache__/**,**/*.md}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/strategies", "destination": "/api/index" },
    { "source": "/strategies/:path*", "destination": "/api/index" },
    { "source": "/brokers", "destination": "/api/index" },
    { "source": "/brokers/:path*", "destination": "/api/index" },
    { "source": "/upstox/:path*", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" }
  ]
}
